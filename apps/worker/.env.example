APP_ENV=development
PORT=8000
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
WORKER_SHARED_SECRET=
TINYFISH_API_KEY=
GOOGLE_API_KEY=
# PDFs are stored in hosted Supabase Storage and parsed directly by Gemini.
LLM_MODEL_FAST=gemini-2.5-flash
LLM_MODEL_STRONG=gemini-2.5-pro
CITATION_CONCURRENCY=8
TINYFISH_SEARCH_RPM=30
TINYFISH_FETCH_CONCURRENCY=3
AGENT_MAX_RUNS_PER_JOB=5
AGENT_DAILY_CAP=60
SUPPORT_MAX_CHARS=400000
CLAIMS_PER_CITATION=3
CURRENCY_MAX_CLAIMS=5
CACHE_TTL_DAYS=7
ENABLE_SECONDARY_SIGNALS=false
